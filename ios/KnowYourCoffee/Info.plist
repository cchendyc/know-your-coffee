<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local dev talks to uvicorn over plain http://127.0.0.1:4000. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS OAuth client ID from the Google Cloud project (bundle id
	     com.knowyourcoffee.app). Empty disables in-app Google sign-in.
	     The same value goes in the backend env as GOOGLE_OAUTH_IOS_CLIENT_ID. -->
	<!-- The palette (cream/espresso) is fixed light; system materials would
	     otherwise go dark and make bars and buttons unreadable in Dark Mode. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>GoogleOAuthClientID</key>
	<string>468965480395-el9e0porpnrf8c4qjdg3n81uqgpstbtj.apps.googleusercontent.com</string>
	<key>NSCameraUsageDescription</key>
	<string>Photograph the machine or menu to autofill your report.</string>
	<!-- Static launch screen matches the espresso backdrop of LaunchAnimation,
	     so there is no flash before the opening animation draws. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
