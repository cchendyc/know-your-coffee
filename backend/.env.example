# Neon Postgres pooled connection string (Dashboard -> Connect).
# Without it the server runs on a non-persistent in-memory store.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Enables the identifyMachine photo-recognition mutation.
# Free key from https://aistudio.google.com/apikey (free tier ~1500 requests/day).
GEMINI_API_KEY=

# Enables the importShopsFromYelp mutation and Yelp source of scripts.import_shops.
YELP_API_KEY=

# Enables the importShopsFromGoogle mutation, Google source of scripts.import_shops,
# addShop geocoding, and scripts.backfill (photos + websites).
GOOGLE_PLACES_API_KEY=

# OAuth 2.0 Web client ID for Google sign-in (console.cloud.google.com -> Credentials).
# The same value goes in web/.env.local as VITE_GOOGLE_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=

# OAuth 2.0 iOS client ID from the same project (bundle id com.knowyourcoffee.app).
# The same value goes in ios Info.plist under GoogleOAuthClientID.
GOOGLE_OAUTH_IOS_CLIENT_ID=

# Twilio for phone sign-in texts (twilio.com/console). Leave unset in dev:
# the code is then returned in the GraphQL response and printed to the server log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend for email sign-in codes (resend.com, free tier 3000/month).
# Same dev fallback as Twilio when unset. EMAIL_FROM must use a domain
# verified in Resend, e.g. "Know Your Coffee <signin@example.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Sign in with Apple audience; defaults to com.knowyourcoffee.app.
# APPLE_BUNDLE_ID=

# Local dev only: return phone/email sign-in codes in the API response when
# no provider is configured. NEVER set in production (account takeover).
AUTH_DEV_CODES=1

# OAuth 2.0 iOS client ID (optional; enables sign-in from the iOS app).
# Create an "iOS" client in the same project with bundle id com.knowyourcoffee.app;
# the same value goes in ios/KnowYourCoffee/Info.plist under GoogleOAuthClientID.
GOOGLE_OAUTH_IOS_CLIENT_ID=

# HMAC secret for session tokens; sessions reset on restart if empty.
SESSION_SECRET=

# Comma-separated emails granted ADMIN on sign-in (claim review, overrides).
ADMIN_EMAILS=

PORT=4000
